<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Futuristic Music Player</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Orbitron:wght@400;500;600;700;800;900&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #0a0a0a;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }

  /* Instagram glow background */
  .glow-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .glow-bg .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.35;
    animation: orbFloat 8s ease-in-out infinite alternate;
  }
  .glow-bg .orb:nth-child(1) { width: 500px; height: 500px; background: #e91e63; top: -15%; left: -10%; animation-delay: 0s; }
  .glow-bg .orb:nth-child(2) { width: 400px; height: 400px; background: #00bcd4; bottom: -10%; right: -5%; animation-delay: -3s; }
  .glow-bg .orb:nth-child(3) { width: 300px; height: 300px; background: #7c4dff; top: 50%; left: 50%; transform: translate(-50%,-50%); animation-delay: -5s; }
  .glow-bg .orb:nth-child(4) { width: 250px; height: 250px; background: #ff6d00; bottom: 20%; left: 10%; animation-delay: -2s; }

  @keyframes orbFloat {
    0% { transform: translate(0,0) scale(1); }
    100% { transform: translate(30px, -20px) scale(1.15); }
  }

  /* iPhone 15 Frame */
  .iphone-frame {
    position: relative;
    z-index: 1;
    width: 393px;
    height: 852px;
    border-radius: 55px;
    background: #1a1a1a;
    border: 3px solid #333;
    box-shadow:
      0 0 0 2px #111,
      0 0 60px rgba(0,0,0,0.8),
      0 0 120px rgba(233,30,99,0.15),
      0 0 120px rgba(0,188,212,0.1),
      inset 0 0 30px rgba(0,0,0,0.5);
    overflow: hidden;
  }

  /* Dynamic Island */
  .dynamic-island {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 126px;
    height: 36px;
    background: #000;
    border-radius: 20px;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .dynamic-island .camera {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: radial-gradient(circle, #1a237e 30%, #0d47a1 60%, #111 70%);
    margin-left: 30px;
  }

  /* Status Bar */
  .status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 28px 0;
    height: 54px;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    position: relative;
    z-index: 90;
  }
  .status-bar .signal { display: flex; gap: 2px; align-items: flex-end; }
  .status-bar .signal span { width: 3px; background: #fff; border-radius: 1px; }
  .status-bar .signal span:nth-child(1) { height: 5px; }
  .status-bar .signal span:nth-child(2) { height: 8px; }
  .status-bar .signal span:nth-child(3) { height: 11px; }
  .status-bar .signal span:nth-child(4) { height: 14px; }
  .status-bar .right { display: flex; align-items: center; gap: 6px; font-size: 12px; }
  .status-bar .battery { width: 25px; height: 12px; border: 1.5px solid #fff; border-radius: 3px; position: relative; }
  .status-bar .battery::after { content:''; position: absolute; right:-4px; top: 2.5px; width: 2px; height: 5px; background: #fff; border-radius: 0 1px 1px 0; }
  .status-bar .battery-fill { position: absolute; left:1px; top:1px; bottom:1px; width: 65%; background: #4caf50; border-radius: 1px; }

  /* App Container */
  .app {
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at 50% 30%, #0d1b2a 0%, #050a10 50%, #000 100%);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  /* Holographic scan lines overlay */
  .app::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,255,255,0.008) 2px,
      rgba(0,255,255,0.008) 4px
    );
    z-index: 50;
    pointer-events: none;
  }

  /* Connection Tag */
  .connection-tag {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 8px 20px 0;
    padding: 6px 14px;
    background: linear-gradient(135deg, rgba(141,28,42,0.35), rgba(80,15,25,0.25));
    border: 1px solid rgba(200,40,60,0.4);
    border-radius: 20px;
    font-size: 10px;
    color: #e57373;
    letter-spacing: 0.5px;
    backdrop-filter: blur(10px);
    position: relative;
    z-index: 10;
  }
  .connection-tag .pulse-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #4caf50;
    box-shadow: 0 0 6px #4caf50;
    animation: pulse 2s ease-in-out infinite;
  }
  .connection-tag .alfa-logo {
    font-family: 'Orbitron', sans-serif;
    font-weight: 700;
    font-size: 9px;
    color: #ef5350;
    letter-spacing: 1.5px;
  }
  @keyframes pulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:0.4; transform:scale(0.7); } }

  /* Album Art Hologram Area */
  .hologram-container {
    position: relative;
    width: 260px;
    height: 260px;
    margin: 14px auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  /* Holographic rings */
  .holo-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid;
    animation: holoSpin 10s linear infinite;
  }
  .holo-ring:nth-child(1) {
    width: 280px; height: 280px;
    border-color: rgba(0,229,255,0.25);
    animation-duration: 12s;
  }
  .holo-ring:nth-child(2) {
    width: 300px; height: 300px;
    border-color: rgba(233,30,99,0.2);
    animation-duration: 18s;
    animation-direction: reverse;
  }
  .holo-ring:nth-child(3) {
    width: 240px; height: 240px;
    border-color: rgba(124,77,255,0.3);
    border-style: dashed;
    animation-duration: 8s;
  }

  @keyframes holoSpin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

  /* Holographic glow behind album */
  .holo-glow {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0,229,255,0.3), rgba(124,77,255,0.15), transparent 70%);
    filter: blur(30px);
    animation: glowPulse 4s ease-in-out infinite;
  }
  @keyframes glowPulse { 0%,100% { opacity:0.6; transform:scale(1); } 50% { opacity:1; transform:scale(1.15); } }

  /* Album Art */
  .album-art {
    width: 200px;
    height: 200px;
    border-radius: 20px;
    position: relative;
    z-index: 5;
    overflow: hidden;
    box-shadow:
      0 0 30px rgba(0,229,255,0.3),
      0 0 60px rgba(124,77,255,0.15),
      0 8px 32px rgba(0,0,0,0.6);
  }
  .album-art-inner {
    width: 100%;
    height: 100%;
    background: url('data:image/webp;base64,') center/cover no-repeat;
    position: relative;
  }
  /* Holographic overlay on art */
  .album-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(0,229,255,0.1) 0%,
      transparent 40%,
      rgba(233,30,99,0.08) 60%,
      transparent 100%
    );
    z-index: 6;
    animation: holoShimmer 3s ease-in-out infinite;
  }
  @keyframes holoShimmer { 0%,100% { opacity:0.5; } 50% { opacity:1; } }

  /* Holographic floating particles */
  .particles {
    position: absolute;
    width: 300px;
    height: 300px;
    z-index: 4;
  }
  .particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: cyan;
    border-radius: 50%;
    opacity: 0;
    animation: particleFloat 4s ease-in-out infinite;
  }

  @keyframes particleFloat {
    0% { opacity:0; transform: translateY(0) scale(0.5); }
    30% { opacity:0.8; }
    100% { opacity:0; transform: translateY(-80px) scale(0); }
  }

  /* Track Info */
  .track-info {
    text-align: center;
    margin-top: 14px;
    z-index: 10;
    position: relative;
  }
  .track-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 1px;
    text-shadow: 0 0 20px rgba(0,229,255,0.4);
  }
  .track-artist {
    font-size: 12px;
    color: #e91e63;
    margin-top: 2px;
    letter-spacing: 2px;
    font-weight: 500;
  }
  .track-album {
    font-size: 9px;
    color: rgba(255,255,255,0.35);
    margin-top: 2px;
    letter-spacing: 1px;
  }
  .lossless-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 5px;
    padding: 2px 10px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    font-size: 8px;
    color: rgba(255,255,255,0.5);
    letter-spacing: 1.5px;
  }

  /* Music Waveform Visualizer */
  .waveform-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5px;
    margin: 10px 30px 0;
    height: 28px;
    z-index: 10;
    position: relative;
  }
  .wave-bar {
    width: 2px;
    border-radius: 2px;
    animation: waveAnim 1.2s ease-in-out infinite;
  }

  @keyframes waveAnim {
    0%, 100% { height: 4px; }
    50% { height: var(--max-h, 20px); }
  }

  /* Progress Bar */
  .progress-section {
    margin: 6px 30px 0;
    z-index: 10;
    position: relative;
  }
  .progress-track {
    width: 100%;
    height: 3px;
    background: rgba(255,255,255,0.1);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    width: 2%;
    border-radius: 2px;
    background: linear-gradient(90deg, #00e5ff, #e91e63);
    position: relative;
    animation: progressMove 180s linear infinite;
  }
  @keyframes progressMove { 0%{width:0%} 100%{width:100%} }
  .progress-fill::after {
    content: '';
    position: absolute;
    right: -4px;
    top: -3px;
    width: 9px;
    height: 9px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(0,229,255,0.6);
  }
  .time-row {
    display: flex;
    justify-content: space-between;
    margin-top: 4px;
    font-size: 10px;
    color: rgba(255,255,255,0.4);
    font-variant-numeric: tabular-nums;
  }

  /* Controls */
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    margin-top: 8px;
    z-index: 10;
    position: relative;
  }
  .ctrl-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(255,255,255,0.6);
    transition: all 0.2s;
  }
  .ctrl-btn:hover { color: #fff; }
  .ctrl-btn svg { display: block; }
  .play-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, #00e5ff, #7c4dff);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 25px rgba(0,229,255,0.35), 0 0 50px rgba(124,77,255,0.2);
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }
  .play-btn:hover { transform: scale(1.08); box-shadow: 0 0 35px rgba(0,229,255,0.5); }
  .play-btn svg { color: #fff; margin-left: 3px; }

  /* Equalizer Section */
  .eq-section {
    margin: 8px 16px 0;
    padding: 10px 12px 8px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 16px;
    z-index: 10;
    position: relative;
    backdrop-filter: blur(10px);
  }
  .eq-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .eq-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 8px;
    color: rgba(0,229,255,0.7);
    letter-spacing: 2px;
  }
  .eq-preset {
    font-size: 8px;
    color: rgba(233,30,99,0.7);
    letter-spacing: 1px;
    padding: 2px 8px;
    border: 1px solid rgba(233,30,99,0.2);
    border-radius: 8px;
  }

  .eq-sliders {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    height: 80px;
    gap: 2px;
  }
  .eq-band {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    height: 100%;
    justify-content: flex-end;
  }
  .eq-slider-track {
    width: 4px;
    height: 58px;
    background: rgba(255,255,255,0.08);
    border-radius: 2px;
    position: relative;
    overflow: visible;
  }
  .eq-slider-fill {
    position: absolute;
    bottom: 0;
    width: 100%;
    border-radius: 2px;
    transition: height 0.6s ease;
  }
  .eq-slider-thumb {
    position: absolute;
    width: 12px;
    height: 6px;
    background: #fff;
    border-radius: 3px;
    left: 50%;
    transform: translateX(-50%);
    box-shadow: 0 0 6px rgba(0,229,255,0.5);
    transition: bottom 0.6s ease;
  }
  .eq-label {
    font-size: 7px;
    color: rgba(255,255,255,0.3);
    margin-top: 4px;
    font-variant-numeric: tabular-nums;
  }
  .eq-value {
    font-size: 6px;
    color: rgba(255,255,255,0.2);
    margin-top: 1px;
  }

  /* Advanced Controls Row */
  .advanced-row {
    display: flex;
    justify-content: space-around;
    margin: 6px 20px 0;
    z-index: 10;
    position: relative;
  }
  .adv-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .adv-btn .icon-circle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.45);
    font-size: 12px;
    transition: all 0.2s;
  }
  .adv-btn .icon-circle.active {
    border-color: rgba(0,229,255,0.4);
    color: #00e5ff;
    background: rgba(0,229,255,0.08);
  }
  .adv-btn span {
    font-size: 7px;
    color: rgba(255,255,255,0.25);
    letter-spacing: 0.5px;
  }

  /* Bottom Nav */
  .bottom-nav {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 8px;
    z-index: 10;
  }
  .home-indicator {
    width: 134px;
    height: 5px;
    background: rgba(255,255,255,0.3);
    border-radius: 3px;
  }

  /* ---- Utility animations ---- */
  @keyframes eqBounce {
    0%, 100% { height: var(--eq-min); }
    50% { height: var(--eq-max); }
  }
</style>
</head>
<body>

<div class="glow-bg">
  <div class="orb"></div>
  <div class="orb"></div>
  <div class="orb"></div>
  <div class="orb"></div>
</div>

<div class="iphone-frame">
  <div class="app">

    <!-- Dynamic Island -->
    <div class="dynamic-island">
      <div class="camera"></div>
    </div>

    <!-- Status Bar -->
    <div class="status-bar">
      <span>18:15</span>
      <div class="right">
        <div class="signal"><span></span><span></span><span></span><span></span></div>
        <span style="font-size:11px;font-weight:700">5G</span>
        <div class="battery"><div class="battery-fill"></div></div>
      </div>
    </div>

    <!-- Connection Tag -->
    <div class="connection-tag">
      <div class="pulse-dot"></div>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#e57373" stroke-width="2">
        <path d="M12 2C8 2 4 4 4 8c0 2 1 3 2 4l6 10 6-10c1-1 2-2 2-4 0-4-4-6-8-6z"/>
        <circle cx="12" cy="8" r="2"/>
      </svg>
      <span style="color:rgba(255,255,255,0.5)">Connected to</span>
      <span class="alfa-logo">ALFA GIULIA</span>
    </div>

    <!-- Hologram Album Art -->
    <div class="hologram-container">
      <div class="holo-ring"></div>
      <div class="holo-ring"></div>
      <div class="holo-ring"></div>
      <div class="holo-glow"></div>
      <div class="particles" id="particles"></div>
      <div class="album-art">
        <div class="album-art-inner"></div>
      </div>
    </div>

    <!-- Track Info -->
    <div class="track-info">
      <div class="track-title">SORROW (LIVE)</div>
      <div class="track-artist">PINK FLOYD</div>
      <div class="track-album">Pulse · 1995</div>
      <div class="lossless-badge">
        <svg width="12" height="8" viewBox="0 0 24 16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M2 8c2-4 4-6 6-6s4 2 6 6c2 4 4 6 6 6"/>
        </svg>
        LOSSLESS · 24-BIT
      </div>
    </div>

    <!-- Waveform -->
    <div class="waveform-container" id="waveform"></div>

    <!-- Progress -->
    <div class="progress-section">
      <div class="progress-track">
        <div class="progress-fill"></div>
      </div>
      <div class="time-row">
        <span id="currentTime">0:02</span>
        <span>-10:47</span>
      </div>
    </div>

    <!-- Controls -->
    <div class="controls">
      <button class="ctrl-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
      </button>
      <button class="ctrl-btn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
      </button>
      <button class="play-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg>
      </button>
      <button class="ctrl-btn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
      </button>
      <button class="ctrl-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18V6l8.5 6L6 18zm10 0V6h2v12h-2z"/></svg>
      </button>
    </div>

    <!-- Equalizer -->
    <div class="eq-section">
      <div class="eq-header">
        <span class="eq-title">EQUALIZER</span>
        <span class="eq-preset">ROCK · LIVE</span>
      </div>
      <div class="eq-sliders" id="eqSliders"></div>
    </div>

    <!-- Advanced Controls -->
    <div class="advanced-row">
      <button class="adv-btn">
        <div class="icon-circle active">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg>
        </div>
        <span>SPATIAL</span>
      </button>
      <button class="adv-btn">
        <div class="icon-circle">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4m0 14v4m-9-11h4m14 0h4"/></svg>
        </div>
        <span>BASS+</span>
      </button>
      <button class="adv-btn">
        <div class="icon-circle active">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <span>VISUAL</span>
      </button>
      <button class="adv-btn">
        <div class="icon-circle">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
        </div>
        <span>LYRICS</span>
      </button>
      <button class="adv-btn">
        <div class="icon-circle">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
        </div>
        <span>QUEUE</span>
      </button>
    </div>

    <!-- Bottom -->
    <div class="bottom-nav">
      <div class="home-indicator"></div>
    </div>

  </div>
</div>

<script>
// Generate waveform bars
const waveContainer = document.getElementById('waveform');
const barCount = 80;
const colors = ['#00e5ff','#7c4dff','#e91e63','#00e5ff','#ff6d00'];
for (let i = 0; i < barCount; i++) {
  const bar = document.createElement('div');
  bar.className = 'wave-bar';
  const maxH = 6 + Math.random() * 22;
  bar.style.setProperty('--max-h', maxH + 'px');
  bar.style.animationDelay = (Math.random() * 1.5) + 's';
  bar.style.animationDuration = (0.6 + Math.random() * 0.8) + 's';
  const colorIdx = Math.floor((i / barCount) * colors.length);
  bar.style.background = colors[colorIdx % colors.length];
  bar.style.opacity = 0.6 + Math.random() * 0.4;
  waveContainer.appendChild(bar);
}

// Generate EQ sliders
const eqContainer = document.getElementById('eqSliders');
const bands = [
  { label: '32', color: '#00e5ff' },
  { label: '64', color: '#00e5ff' },
  { label: '125', color: '#00e5ff' },
  { label: '250', color: '#7c4dff' },
  { label: '500', color: '#7c4dff' },
  { label: '1K', color: '#e91e63' },
  { label: '2K', color: '#ff6d00' },
  { label: '4K', color: '#ff6d00' },
  { label: '8K', color: '#e91e63' },
  { label: '16K', color: '#e91e63' }
];

const eqValues = [65, 55, 40, 50, 30, 70, 80, 45, 35, 50];

bands.forEach((band, i) => {
  const el = document.createElement('div');
  el.className = 'eq-band';
  const baseVal = eqValues[i];
  const db = Math.round((baseVal - 50) * 0.24);
  el.innerHTML = `
    <div class="eq-slider-track">
      <div class="eq-slider-fill" style="height:${baseVal}%; background:linear-gradient(to top, ${band.color}44, ${band.color})" data-base="${baseVal}" data-idx="${i}"></div>
      <div class="eq-slider-thumb" style="bottom:${baseVal - 5}%" data-base="${baseVal}" data-idx="${i}"></div>
    </div>
    <div class="eq-label">${band.label}</div>
    <div class="eq-value" data-idx="${i}">${db > 0 ? '+' : ''}${db}</div>
  `;
  eqContainer.appendChild(el);
});

// Animate EQ sliders subtly
function animateEQ() {
  const fills = document.querySelectorAll('.eq-slider-fill');
  const thumbs = document.querySelectorAll('.eq-slider-thumb');
  const vals = document.querySelectorAll('.eq-value');

  fills.forEach((fill, i) => {
    const base = parseFloat(fill.dataset.base);
    const offset = (Math.sin(Date.now() * 0.003 + i * 0.8) * 8) + (Math.sin(Date.now() * 0.007 + i * 1.2) * 4);
    const newVal = Math.max(10, Math.min(95, base + offset));
    fill.style.height = newVal + '%';
    thumbs[i].style.bottom = (newVal - 5) + '%';
    const db = Math.round((newVal - 50) * 0.24);
    vals[i].textContent = (db > 0 ? '+' : '') + db;
  });
  requestAnimationFrame(animateEQ);
}
animateEQ();

// Generate floating particles
const particlesEl = document.getElementById('particles');
for (let i = 0; i < 20; i++) {
  const p = document.createElement('div');
  p.className = 'particle';
  p.style.left = (20 + Math.random() * 260) + 'px';
  p.style.top = (80 + Math.random() * 140) + 'px';
  p.style.animationDelay = (Math.random() * 4) + 's';
  p.style.animationDuration = (3 + Math.random() * 3) + 's';
  p.style.background = ['#00e5ff','#e91e63','#7c4dff','#fff'][Math.floor(Math.random()*4)];
  p.style.width = (2 + Math.random() * 3) + 'px';
  p.style.height = p.style.width;
  particlesEl.appendChild(p);
}

// Update time counter
let seconds = 2;
setInterval(() => {
  seconds++;
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  document.getElementById('currentTime').textContent = m + ':' + String(s).padStart(2, '0');
}, 1000);
</script>

